# MindBridge 2.0 - Environment Configuration Template
# Copy this file to '.env' and update the values for your local environment.
# DO NOT commit real secrets or credentials to version control.

# ==============================================================================
# 1. Server & Runtime Configuration
# ==============================================================================
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
# Maximum rate limit per client IP (sliding window of 60 seconds)
RATE_LIMIT_PER_MINUTE=60
MAX_CONCURRENT_REQUESTS=10

# Reverse proxy security: comma-separated list of trusted proxy IPs or narrow CIDRs.
# Only proxies in this list are allowed to forward client IPs via X-Forwarded-For.
# WARNING: Do NOT use broad private CIDRs such as 10.0.0.0/8. Using 10.0.0.0/8
# permits ANY machine in that private network to spoof client IPs and bypass rate limits.
# Use exact loopback addresses (127.0.0.1,::1) or a specific ingress proxy IP/narrow subnet.
TRUSTED_PROXIES=127.0.0.1,::1

MAX_BODY_SIZE_BYTES=65536

# Worker concurrency for Uvicorn ASGI server.
# NOTE: Rate limiting and concurrency semaphores are currently process-local (in-memory).
# Running WEB_CONCURRENCY > 1 divides request limits per worker and weakens protections.
# Staging deployments MUST maintain WEB_CONCURRENCY=1 until a shared distributed backend exists.
WEB_CONCURRENCY=1

# ==============================================================================
# 2. Regional Jurisdiction & Safety Defaults
# ==============================================================================
# Supported codes: IN (India), US (United States), UK (United Kingdom), CA (Canada), AU (Australia), GL (Global)
DEFAULT_JURISDICTION=IN

# Crisis routing probability threshold (calibrated during Phase 4 Step 4)
CRISIS_PROBABILITY_THRESHOLD=0.509765625

# Graceful degradation toggle: If true, classifier errors trigger supportive fallback with helpline references
SAFE_DEGRADATION_ON_ERROR=true

# ==============================================================================
# 3. Model & Inference Configuration (CPU-First Local Models)
# ==============================================================================
# Local directory path to fine-tuned RoBERTa crisis classifier
CRISIS_MODEL_DIR=models/crisis_detector/roberta

# Local directory path to BAAI/bge-small-en-v1.5 embedding model
EMBEDDING_MODEL_DIR=models/embeddings/bge-small-en-v1.5

# Dense vector retrieval threshold (calibrated starting threshold)
RETRIEVAL_SIMILARITY_THRESHOLD=0.65
RETRIEVAL_TOP_K=5

# ==============================================================================
# 4. LLM Generation Providers (Gemini / Groq / Local)
# ==============================================================================
# Provider selection: 'auto', 'gemini', 'groq', or 'local'
# 'auto': Primary Gemini Developer API -> Fallback Groq Cloud API -> Final Fallback Local deterministic
LLM_PROVIDER=auto

# --- Provider Option A: Google AI Studio (Gemini Developer API) ---
ENABLE_GEMINI=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REQUEST_TIMEOUT=10.0
GEMINI_MAX_RETRIES=1

# --- Provider Option B: Groq Cloud API ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REQUEST_TIMEOUT=10.0
GROQ_MAX_RETRIES=1

# Legacy / Alternative Provider Options (Optional)
LLM_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
HUGGINGFACE_API_KEY=

# ==============================================================================
# 5. Telemetry & Privacy Controls
# ==============================================================================
# Ephemeral telemetry database path (in-memory SQLite by default; never logs prompt text)
TELEMETRY_DB_URL=sqlite:///:memory:
LOG_LEVEL=INFO
ENABLE_PII_SCRUBBING=true
